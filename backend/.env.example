# Required for online district event listings in Happenings.
SERPAPI_API_KEY=your_serpapi_private_key

# Local MySQL database (create hapzo360 before starting the server)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hapzo360
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password

# Firebase Authentication project used to verify Google sign-in ID tokens
FIREBASE_PROJECT_ID=hapzo360

# Individual signup email verification (server-side only)
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password_or_app_password
SMTP_FROM=Hapzo360 <no-reply@your-domain.com>

# Create the first posting/reviewing admin on server startup. Keep this password private.
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=choose_a_long_unique_password

# Read-only super admin account. Set these privately on the server.
READ_ONLY_SUPER_ADMIN_USERNAME=SAdmin
READ_ONLY_SUPER_ADMIN_PASSWORD=choose_a_unique_password

# Optional for a deployed frontend on a different origin
FRONTEND_ORIGIN=https://hapzo360.netlify.app

# Demo expiry mode for local testing only
JOB_EXPIRY_TEST_MODE=false
JOB_EXPIRY_TEST_AFTER_MINUTES=1
